# -*- text -*-
##
## rlm_sql configuration for PostgreSQL 16
## FreeRADIUS 3.2.x Module Configuration
## Project: ISP Billing Software (by Tapos)
##

sql {
    # Driver type: PostgreSQL
    dialect = "postgresql"
    driver = "rlm_sql_postgresql"

    # Connection Parameters
    server = "postgres"
    port = 5432
    login = "radius_user"
    password = "${DB_PASSWORD}"
    radius_db = "isp_billing"

    # Dynamic Client Registration from `nas` table
    # This instructs FreeRADIUS to read the PostgreSQL `nas` table at startup and runtime
    read_clients = yes
    nas_table = "nas"

    # Table Names
    acct_table1 = "radacct"
    acct_table2 = "radacct"
    postauth_table = "radpostauth"
    authcheck_table = "radcheck"
    authreply_table = "radreply"
    groupcheck_table = "radgroupcheck"
    groupreply_table = "radgroupreply"
    usergroup_table = "radusergroup"

    # Strip domain realm
    delete_stale_sessions = yes

    # Connection Pool Management for Ultra-Low Latency (<10ms)
    pool {
        start = 5
        min = 5
        max = 32
        spare = 5
        uses = 0
        retry_delay = 30
        lifetime = 0
        idle_timeout = 60
    }

    client_table = "nas"
    group_attribute = "SQL-Group"
    $INCLUDE ${modconfdir}/${.:name}/main/${dialect}/queries.conf
}
