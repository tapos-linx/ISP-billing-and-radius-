# Set default behavior to automatically normalize line endings
* text=auto

# Enforce LF (Unix line endings) on shell scripts, SQL schemas, and FreeRADIUS configs
# This prevents Windows CRLF \r\n corruption inside WSL2 and Docker containers
*.sh text eol=lf
*.sql text eol=lf
*.conf text eol=lf
*.rsc text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env text eol=lf
*.env.example text eol=lf

# Windows PowerShell scripts can use CRLF or LF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Git attributes for binaries
*.png binary
*.jpg binary
*.webp binary
*.jar binary
*.keystore binary
