{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "ISP Billing & Telecom Architect Console",
  "short_name": "ISP Billing",
  "description": "Telecom BSS/OSS & Network Automation architect console for FreeRADIUS 3.x, Mikrotik RouterOS v7, PostgreSQL 16, RFC 3576 CoA/PoD, and Customer Self-Care PWA.",
  "id": "/?source=pwa",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#041a31",
  "theme_color": "#041a31",
  "categories": [
    "business",
    "finance",
    "productivity",
    "utilities",
    "telecommunications"
  ],
  "lang": "en-US",
  "dir": "ltr",
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "auto"
  },
  "icons": [
    {
      "src": "/icons/icon-48x48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    },
