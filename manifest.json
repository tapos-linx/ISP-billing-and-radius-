{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "ISP Billing & Telecom Architect Console",
  "short_name": "ISP Billing",
  "description": "Telecom BSS/OSS & Network Automation architect console for FreeRADIUS 3.x, Mikrotik RouterOS v7, PostgreSQL 16, RFC 3576 CoA/PoD, and Customer Self-Care PWA.",
  "id": "/?source=pwa",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0f172a",
  "theme_color": "#0284c7",
  "categories": [
    "business",
    "finance",
    "productivity",
    "utilities",
    "telecommunications"
  ],
  "lang": "en-US",
  "dir": "ltr",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Customer Self-Care",
      "short_name": "Self-Care",
      "description": "View live data usage, bandwidth, and extend validity with bKash",
      "url": "/#selfcare",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "RFC 3576 CoA Lab",
      "short_name": "CoA Lab",
      "description": "Send RFC 3576 Packet of Disconnect (UDP 3799) to NAS",
      "url": "/#coa-lab",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "RouterOS v7 Generator",
      "short_name": "RouterOS",
      "description": "Generate Mikrotik PPPoE, RADIUS client, and Walled Garden firewall scripts",
      "url": "/#mikrotik",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "MFS Webhook Simulator",
      "short_name": "MFS Payments",
      "description": "Simulate bKash / Nagad instant invoice settlement and CoA trigger",
      "url": "/#mfs-webhook",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
