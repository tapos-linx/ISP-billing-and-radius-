    {
      "src": "/screenshots/mobile-preview.png",
      "sizes": "1080x2400",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "ISP Billing Customer Self-Care & Real-Time Usage"
    },
    {
      "src": "/screenshots/desktop-preview.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "ISP Telecom BSS/OSS Architect Console"
    }
  ],
  "shortcuts": [
    {
      "name": "Customer Self-Care",
      "short_name": "Self-Care",
      "description": "View live data usage, bandwidth, and extend validity with bKash",
      "url": "/#selfcare",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
