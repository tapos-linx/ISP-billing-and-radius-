# ==============================================================================
# ISP Billing & FreeRADIUS Automation — Master Environment Template
# Copy to .env (local) or upload secrets to GCP Secret Manager (production)
# ==============================================================================

# --- 1. Gemini Interface, Google AI Studio, Antigravity & Gemini CLI ---
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
AI_STUDIO_APPLET_ID=d016e5ed-476a-4216-8ba2-08a862a64366
ANTIGRAVITY_PROJECT_NAME=isp-billing-radius-bss

# --- 2. Google Cloud Platform (GCP) ---
GOOGLE_CLOUD_PROJECT=isp-billing-prod-bd
GOOGLE_CLOUD_REGION=asia-south1
CLOUD_RUN_SERVICE=isp-billing-bss-api
GCP_VPC_CONNECTOR=isp-vpc-connector

# --- 3. Citus 12.1 + PostgreSQL 16 (128 Subscriber Shards / 256 Radacct Shards) ---
DB_CONNECTION=pgsql
DB_HOST=citus_master
DB_PORT=5432
DB_DATABASE=isp_bss_oss
DB_USERNAME=isp_admin
DB_PASSWORD=REPLACE_WITH_STRONG_PG_PASSWORD
CITUS_SUBSCRIBER_SHARDS=128
CITUS_RADACCT_SHARDS=256

# --- 4. Redis 7 Fast-Path & Webhook Idempotency ---
REDIS_HOST=redis_cluster
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_REDIS_AUTH
REDIS_POLICY=noeviction
REDIS_AUTH_CACHE_TTL=300

# --- 5. FreeRADIUS 3.2+ & RFC 3576 CoA/PoD (GCE Ubuntu 24.04 LTS + WireGuard) ---
RADIUS_SERVER_HOST=10.10.0.10
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
RADIUS_COA_PORT=3799
RADIUS_SECRET=REPLACE_WITH_WIREGUARD_RADIUS_SECRET
WALLED_GARDEN_POOL=walled_garden_pool

# --- 6. Message Broker / Async Workers ---
QUEUE_CONNECTION=rabbitmq
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=isp_rabbit
RABBITMQ_PASSWORD=REPLACE_WITH_RABBITMQ_PASSWORD

# --- 7. MikroTik RouterOS v7 & GenieACS TR-069 ---
ROUTEROS_API_HOST=10.10.10.2
ROUTEROS_API_PORT=8728
ROUTEROS_REST_PORT=443
ROUTEROS_API_USER=bss_automation
ROUTEROS_API_PASS=REPLACE_WITH_ROUTEROS_PASSWORD
GENIEACS_NBI_URL=http://10.10.0.20:7557

# --- 8. Bangladesh MFS Fintech Webhooks (HMAC-SHA256) ---
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_APP_KEY=REPLACE_WITH_BKASH_APP_KEY
BKASH_APP_SECRET=REPLACE_WITH_BKASH_APP_SECRET
BKASH_USERNAME=REPLACE_WITH_BKASH_USERNAME
BKASH_PASSWORD=REPLACE_WITH_BKASH_PASSWORD
NAGAD_MERCHANT_ID=REPLACE_WITH_NAGAD_MERCHANT_ID
NAGAD_MERCHANT_KEY=REPLACE_WITH_NAGAD_PRIVATE_KEY
SSLCOMMERZ_STORE_ID=REPLACE_WITH_SSLCOMMERZ_ID
SSLCOMMERZ_STORE_PASSWD=REPLACE_WITH_SSLCOMMERZ_PASS

# --- 9. App & Cron Security ---
APP_TIMEZONE=Asia/Dhaka
CRON_JOB_SECRET=REPLACE_WITH_CLOUD_SCHEDULER_OIDC_SECRET
