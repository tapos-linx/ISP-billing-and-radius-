{
  "title": "ISP Billing & FreeRADIUS SLA Dashboard",
  "uid": "isp-noc-sla-v1",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "FreeRADIUS Access-Accepts / sec",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(freeradius_access_accepts_total[1m])"
        }
      ]
    },
    {
      "id": 2,
      "title": "PostgreSQL Active Connections",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(pg_stat_activity_count)"
        }
      ]
    },
    {
      "id": 3,
      "title": "Redis Memory & Evictions",
      "type": "stat",
      "targets": [
        {
          "expr": "redis_evicted_keys_total"
        }
      ]
    }
  ]
}